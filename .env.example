# --- Data pipeline (laptop only, never on Vercel) ---
# TMDB "API Read Access Token" (the long one starting with eyJ...), used by pipeline/run_pipeline.py
TMDB_READ_TOKEN=

# --- Website (add these in Vercel -> Settings -> Environment Variables) ---
# Random string of at least 32 characters, used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Supabase -> Project Settings -> API: "Project URL" and the "service_role" secret key.
# Without these, local development saves likes to data/app-likes.json instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
